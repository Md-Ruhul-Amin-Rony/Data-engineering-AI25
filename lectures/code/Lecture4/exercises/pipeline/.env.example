# Copy this file to .env before starting:   cp .env.example .env
# Then paste your own API key below. .env is gitignored; this file is not.
#
# One .env for the whole project. Compose passes it to both the database and
# the ingestion service at RUN time, so editing it takes effect on the next
# `docker compose up` - no image rebuild needed.

# Read by the Postgres container the first time it starts, to create the user
# and the database. Changing them later requires: docker compose down -v
POSTGRES_USER=aim25
POSTGRES_PASSWORD=password123
POSTGRES_DB=datawarehouse

# Get a free key at https://www.weatherapi.com/ (sign up -> API key).
API_URL=https://api.weatherapi.com/v1/forecast.json
API_KEY=your_api_key_here